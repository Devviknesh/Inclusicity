# =========================================================
# InclusiCity Backend Environment Configuration
# =========================================================

# Server Configuration
PORT=5000
FLASK_DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173

# Database (MongoDB Connection URI)
MONGO_URI=mongodb://localhost:27017/inclusicity

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-secret
JWT_EXPIRY_HOURS=24

# Redis & Celery Background Processing
REDIS_URL=redis://localhost:6379/0

# SMTP Email Configuration (Google App Password / SendGrid / Brevo)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-smtp-app-password
FRONTEND_URL=http://localhost:5173

# Admin Account Initialization (seed_admin.py)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@inclusicity.com
ADMIN_PASSWORD=change-this-to-a-strong-admin-password
